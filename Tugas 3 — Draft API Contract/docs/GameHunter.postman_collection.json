{
  "info": {
    "name": "Tugas 3 - GameHunter Contract (Mock)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Mock contract Minggu 3; bukan backend Laravel atau data live."
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:3003"
    }
  ],
  "item": [
    {
      "name": "Daftar game",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/games"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Data sesuai contract',()=>{ const d=pm.response.json().data; const rows=Array.isArray(d)?d:[d]; rows.forEach(g=>{pm.expect(g.id).to.be.a('number');pm.expect(g.title).to.be.a('string');pm.expect(g.is_free).to.be.a('boolean');pm.expect(g.platform).to.be.oneOf(['pc','browser']);pm.expect(g.updated_at).to.match(/^\\d{4}-\\d{2}-\\d{2}T/);}); });"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "200",
          "originalRequest": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/games"
          },
          "status": "OK",
          "code": 200,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"data\": [\n    {\n      \"id\": 1,\n      \"title\": \"Game Contoh\",\n      \"platform\": \"pc\",\n      \"is_free\": true,\n      \"source\": \"fixture\",\n      \"updated_at\": \"2026-09-30T00:00:00Z\"\n    }\n  ]\n}"
        }
      ]
    },
