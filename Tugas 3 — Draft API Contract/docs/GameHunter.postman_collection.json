    {
      "name": "Game tidak ada",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/games/999"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 404', () => pm.response.to.have.status(404));",
              "pm.test('JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Error sesuai contract',()=>{const b=pm.response.json(); pm.expect(b.message).to.be.a('string'); pm.expect(b.errors).to.equal(null); });"
            ]
          }
        }
