    {
      "name": "Platform salah",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/games?platform=console"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 422', () => pm.response.to.have.status(422));",
              "pm.test('JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Error sesuai contract',()=>{const b=pm.response.json(); pm.expect(b.message).to.be.a('string'); pm.expect(b.errors.platform).to.be.an(\"array\"); });"
            ]
          }
        }
